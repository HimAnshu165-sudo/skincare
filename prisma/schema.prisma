datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --------------------------------------------------
// USER & AUTHENTICATION
// --------------------------------------------------

model User {
  id            String      @id @default(cuid())
  name          String
  email         String      @unique
  password      String      // Hashed with bcrypt
  phone         String?
  role          String      @default("CUSTOMER") // "CUSTOMER" | "ADMIN"
  adminMfaPin   String?     // Optional bcrypt-hashed 6-digit PIN for Admin MFA step-up authentication
  addresses     Address[]
  cart          Cart?
  orders        Order[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([email])
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String
  country      String   @default("India")
  addressType  String   @default("HOME") // "HOME" | "WORK" | "OTHER"
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

// --------------------------------------------------
// CART SYSTEM (USER & GUEST)
// --------------------------------------------------

model Cart {
  id         String     @id @default(cuid())
  userId     String?    @unique
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestToken String?    @unique
  items      CartItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([userId])
  @@index([guestToken])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
}

// --------------------------------------------------
// PRODUCT CATALOG
// --------------------------------------------------

model Product {
  id              String         @id @default(cuid())
  name            String
  slug            String         @unique
  tagline         String
  description     String
  price           Float
  mrp             Float
  inStock         Boolean        @default(true)
  stockQuantity   Int            @default(100)
  sku             String         @unique
  volume          String         // e.g. "50ml / 1.7 fl. oz."
  spfRating       String?        // e.g. "SPF 50+ PA++++"
  finish          String?        // e.g. "Invisible Dewy-Matte"
  skinType        String?        // e.g. "All Skin Types • Non-Comedogenic"
  images          String         // JSON stringified array of URLs (legacy/fallback)
  productImages   ProductImage[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  benefits        String         // JSON stringified array of strings
  keyIngredients  String         // JSON stringified array of { name: string, benefit: string }
  fullIngredients String
  howToUse        String
  isFeatured      Boolean        @default(false)
  isUpcoming      Boolean        @default(false)
  category        String         // "Sunscreens" | "Moisturizers" | "Cleansers" | "Sets"
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([slug])
  @@index([category])
  @@index([isFeatured])
}

model ProductImage {
  id          String   @id @default(cuid())
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  url         String
  pathname    String
  alt         String
  sortOrder   Int      @default(0)
  isPrimary   Boolean  @default(false)
  width       Int?
  height      Int?
  size        Int?
  contentType String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId])
}

// --------------------------------------------------
// ORDERS & PAYMENTS
// --------------------------------------------------

model Order {
  id                  String               @id @default(cuid())
  orderNumber         String               @unique // e.g. "VEL-89234"
  userId              String?
  user                User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName        String
  customerEmail       String
  customerPhone       String
  shippingAddress     String               // JSON snapshot: { fullName, phone, addressLine1, addressLine2, city, state, postalCode }
  paymentMethod       String               // "ONLINE" | "COD"
  paymentStatus       String               @default("PENDING") // "PENDING" | "PAID" | "FAILED" | "REFUNDED"
  orderStatus         String               @default("PLACED")  // "PLACED" | "CONFIRMED" | "PROCESSING" | "PACKED" | "SHIPPED" | "OUT_FOR_DELIVERY" | "DELIVERED" | "CANCELLED"
  subtotal            Float
  discount            Float                @default(0)
  shippingFee         Float                @default(0)
  total               Float
  couponCode          String?
  razorpayOrderId     String?
  razorpayPaymentId   String?
  trackingNumber      String?
  courierName         String?
  trackingUrl         String?
  notes               String?
  items               OrderItem[]
  payments            Payment[]
  statusHistory       OrderStatusHistory[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([userId])
  @@index([orderNumber])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  productName String
  productSlug String?
  productSku  String?
  imageUrl    String?
  quantity    Int
  price       Float    // Snapshot of price at time of order
  volume      String?
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                String   @id @default(cuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount            Float
  currency          String   @default("INR")
  method            String   // "RAZORPAY" | "COD"
  status            String   @default("PENDING") // "PENDING" | "PAID" | "FAILED" | "REFUNDED"
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  rawPayload        String?  // JSON metadata/logs for idempotency and webhooks
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([orderId])
  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
}

model OrderStatusHistory {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      String   // "PLACED" | "CONFIRMED" | "PROCESSING" | "PACKED" | "SHIPPED" | "OUT_FOR_DELIVERY" | "DELIVERED" | "CANCELLED"
  title       String
  description String?
  location    String?
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([createdAt])
}

// --------------------------------------------------
// PROMOTIONS & MARKETING
// --------------------------------------------------

model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  discountType  String    // "PERCENTAGE" | "FIXED"
  discountValue Float
  minOrderValue Float     @default(0)
  isActive      Boolean   @default(true)
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([code])
}

// --------------------------------------------------
// ADMIN AUDIT LOGS
// --------------------------------------------------

model AdminAuditLog {
  id           String   @id @default(cuid())
  adminUserId  String
  action       String   // "ADMIN_LOGIN" | "ADMIN_LOGIN_FAILED" | "ORDER_STATUS_CHANGED" | "PAYMENT_STATUS_CHANGED" | "PRODUCT_CREATED" | "PRODUCT_UPDATED" | "PRODUCT_DELETED" | "INVENTORY_UPDATED" | "CUSTOMER_DATA_ACCESS"
  resourceType String   // "ORDER" | "PRODUCT" | "INVENTORY" | "PAYMENT" | "CUSTOMER" | "AUTH" | "MEDIA"
  resourceId   String?
  metadata     String?  // Sanitized JSON string (NO passwords, tokens, secrets)
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([adminUserId])
  @@index([action])
  @@index([resourceType])
  @@index([createdAt])
}

